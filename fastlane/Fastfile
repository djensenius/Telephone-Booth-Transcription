default_platform(:mac)

API_KEY = {
  key_id: "XP65R4N5A2",
  issuer_id: "69a6de7e-a5f5-47e3-e053-5b8c7c11a4d1",
  key_filepath: File.expand_path("~/.appstoreconnect/AuthKey_XP65R4N5A2.p8")
}

APP_NAME           = "Telephone Booth Transcription"
APP_SKU            = "tb-transcription"
APP_VERSION        = "0.1.0"
PRIMARY_BUNDLE_ID  = "org.davidjensenius.TelephoneBoothTranscription"
PRIMARY_LANGUAGE   = "en-CA"

# App Store keywords are applied per version localization via Spaceship because
# this repo cannot carry a `metadata/<locale>/keywords.txt` file (it is excluded
# by an organization content policy).
KEYWORDS = "transcription,whisper,speech,moderation,openai,api,on-device,server,translate,booth"

# App Store Connect platforms the app record is created for. The repository
# currently only ships a native macOS target; the iOS record is a placeholder
# for a future companion app. `produce`-style platform identifiers.
PLATFORMS = %w[ios osx].freeze

def connect_api_token
  require "spaceship"
  token = Spaceship::ConnectAPI::Token.create(
    key_id: API_KEY[:key_id],
    issuer_id: API_KEY[:issuer_id],
    filepath: API_KEY[:key_filepath]
  )
  Spaceship::ConnectAPI.token = token
  token
end

platform :mac do
  desc "Register the Developer Portal bundle ID (universal, covers iOS + macOS) using the App Store Connect API key. Idempotent."
  lane :register_bundle_ids do
    connect_api_token

    existing = Spaceship::ConnectAPI::BundleId.find(PRIMARY_BUNDLE_ID)
    if existing
      UI.success("Bundle ID already exists on Developer Portal: #{PRIMARY_BUNDLE_ID}")
    else
      UI.message("Registering bundle ID on Developer Portal: #{PRIMARY_BUNDLE_ID}")
      Spaceship::ConnectAPI::BundleId.create(
        name: APP_NAME,
        identifier: PRIMARY_BUNDLE_ID,
        platform: "UNIVERSAL"
      )
      UI.success("Created bundle ID: #{PRIMARY_BUNDLE_ID}")
    end
  end

  desc "Create the App Store Connect app record for #{PLATFORMS.join(', ')}. " \
       "Apple does not allow app creation through the App Store Connect API key " \
       "(`apps` rejects CREATE), so this lane uses `produce`, which logs in with " \
       "the Apple ID from the Appfile and prompts for 2FA. Run it interactively. " \
       "Idempotent: skips if the app already exists."
  lane :create_app_record do
    # `produce` creates the app through the Apple ID web (Tunes) session. Make
    # sure no API-key token is active, otherwise app creation is routed to the
    # official API, which forbids CREATE.
    require "spaceship"
    Spaceship::ConnectAPI.token = nil

    produce(
      app_identifier: PRIMARY_BUNDLE_ID,
      app_name: APP_NAME,
      sku: APP_SKU,
      app_version: APP_VERSION,
      language: PRIMARY_LANGUAGE,
      platforms: PLATFORMS,
      skip_devcenter: true # bundle ID is registered by `register_bundle_ids`
    )
  end

  desc "End-to-end app registration: bundle ID (API key) + App Store Connect record (interactive Apple ID + 2FA), iOS + macOS."
  lane :create_app do
    register_bundle_ids
    create_app_record
  end

  desc "Upload text metadata for every platform to App Store Connect (no binaries, no screenshots). Safe to re-run."
  lane :upload_store_metadata do
    deliver_platform("osx")
    deliver_platform("ios")
    set_keywords_all(KEYWORDS)
  end
end

# Uploads text metadata for one App Store platform without touching the binary
# or screenshots. Safe to re-run.
def deliver_platform(platform)
  deliver(
    app_identifier: PRIMARY_BUNDLE_ID,
    platform: platform,
    metadata_path: File.expand_path("metadata", __dir__),
    skip_binary_upload: true,
    skip_screenshots: true,
    run_precheck_before_submit: false,
    submit_for_review: false,
    automatic_release: false,
    force: true
  )
end

# Sets the keyword field on the editable version localization of every platform,
# working around the missing keywords.txt metadata file.
def set_keywords_all(keywords)
  connect_api_token
  app = Spaceship::ConnectAPI::App.find(PRIMARY_BUNDLE_ID)
  return UI.important("App not found; cannot set keywords.") if app.nil?

  app.get_app_store_versions.each do |version|
    next unless version.app_store_state == "PREPARE_FOR_SUBMISSION"

    version.get_app_store_version_localizations.each do |loc|
      loc.update(attributes: { keywords: keywords })
      UI.success("Set keywords for #{version.platform} #{loc.locale}")
    end
  end
end
